# Google Cloud Run image for agent Plan Match (agent.generationhealth.me).
# Vercel ignores this file and keeps building from vercel.json.
#
# Stage 1 builds the site (dist) and bundles every API function into
# build/api. Stage 2 ships only what runs, plus the headless browser that
# api/drug-costs.ts launches (playwright-core + @sparticuz/chromium).

FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Public browser settings, baked into the site at build time (same as Vercel).
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_PLANMATCH_WIZARD_URL
ARG VITE_APP_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_PLANMATCH_WIZARD_URL=$VITE_PLANMATCH_WIZARD_URL \
    VITE_APP_URL=$VITE_APP_URL
RUN npx vite build && node scripts/gcp/build-api.cjs

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
# Shared libraries Chromium needs on Debian.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates fonts-liberation libnss3 libnspr4 \
    libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libgbm1 libxkbcommon0 libxcomposite1 \
    libxdamage1 libxfixes3 libxrandr2 libasound2 libpango-1.0-0 libcairo2 libexpat1 \
 && rm -rf /var/lib/apt/lists/*
RUN npm init -y >/dev/null && npm install --no-audit --no-fund --omit=dev playwright-core@1.59.1 @sparticuz/chromium@147.0.2
COPY --from=build /app/dist ./dist
COPY --from=build /app/build/api ./build/api
COPY --from=build /app/server ./server
COPY --from=build /app/vercel.json ./vercel.json
USER node
EXPOSE 8080
CMD ["node", "server/server.cjs"]
